# npm run setup generates a random secret in .env.local. Never commit the real file.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PATH=.data/salsal.sqlite
# Optional development seed account overrides; otherwise random passwords are generated.
SEED_DEMO_ACCOUNTS=true
DEMO_ADMIN_EMAIL=admin@demo.salsal.test
DEMO_ADMIN_PASSWORD=
DEMO_CLIENT_EMAIL=client@demo.salsal.test
DEMO_CLIENT_PASSWORD=
# Enable only behind an ingress that replaces user-supplied X-Forwarded-For.
TRUST_PROXY=false
