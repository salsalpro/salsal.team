# npm run setup generates a random secret in .env.local. Never commit the real file.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PATH=.data/salsal.sqlite
# Optional development seed account overrides; otherwise random passwords are generated.
SEED_ADMIN_EMAIL=admin@salsal.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=client@salsal.local
SEED_USER_PASSWORD=
