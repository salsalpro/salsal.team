{
  "name": "salsal-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:setup": "node --env-file=.env.local --import tsx scripts/db-setup.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "setup": "node scripts/setup-env.mjs && npm run db:setup"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "^12.4.1",
    "zod": "^4.1.12",
    "lucide-react": "^0.468.0",
    "server-only": "^0.0.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.2.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "tailwindcss": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
